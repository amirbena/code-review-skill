    "evidence": {
      "correctness-off-by-one-pagination": "{\n  \"id\": \"correctness-off-by-one-pagination\",\n  \"input_kind\": \"patch\",\n  \"produced_findings\": [\n    {\n      \"claim\": \"Off-by-one in page slice returns `page_size + 1` items The diff changes the slice end from `offset + page_size` to `offset + page_size + 1`. Python slices already exclude the end index, so the `+ 1` is wrong. For `items=[1..10]`, `page_number=1`, `page_size=3`, the result is `[1, 2, 3, 4]` instead of `[1, 2, 3]`. Page 2 then starts at `4`, which page 1 already returned. Every page returns one item too many and duplicates the first item of the next page. Any caller that relies on the page size or walks the pages will see wrong results, for example a UI showing 11 rows for a page size of 10.\",\n      \"extra\": {\n        \"defect_kind\": \"off-by-one\",\n        \"evidence_quotes\": [\n          \"offset + page_size\",\n          \"offset + page_size + 1\",\n          \"+ 1\",\n          \"items=[1..10]\",\n          \"page_number=1\",\n          \"page_size=3\",\n          \"[1, 2, 3, 4]\",\n          \"[1, 2, 3]\",\n          \"4\"\n        ]\n      },\n      \"location\": {\n        \"line\": 3,\n        \"path\": \"app/pagination.py\"\n      },\n      \"severity\": \"P0\"\n    }\n  ],\n  \"status\": \"executed\"\n}",
      "quality-duplicated-branch-logic": "{\n  \"id\": \"quality-duplicated-branch-logic\",\n  \"input_kind\": \"patch\",\n  \"produced_findings\": [\n    {\n      \"claim\": \"`sms` branch duplicates the `email` branch's message-formatting logic the new `elif kind == \\\"sms\\\":` branch repeats `msg = format_message(user)` from the `email` branch at lines 3-4. The two branches differ only in the send function and the contact field (`send_email(user.email, \\u2026)` vs `send_sms(user.phone, \\u2026)`). each additional channel copies the same formatting step, so a change to how the message is built has to be made in every branch and can drift between them. Consistency and maintainability suffer. This is not a correctness defect today.\",\n      \"extra\": {\n        \"defect_kind\": \"duplicated-branch-logic\",\n        \"evidence_quotes\": [\n          \"elif kind == \\\"sms\\\":\",\n          \"msg = format_message(user)\",\n          \"email\",\n          \"send_email(user.email, \\u2026)\",\n          \"send_sms(user.phone, \\u2026)\"\n        ]\n      },\n      \"location\": {\n        \"lines\": {\n          \"end\": 7,\n          \"start\": 5\n        },\n        \"path\": \"app/notify.py\"\n      },\n      \"severity\": \"P2\"\n    }\n  ],\n  \"status\": \"executed\"\n}"
