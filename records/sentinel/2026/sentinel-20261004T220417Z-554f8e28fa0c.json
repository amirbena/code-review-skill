    "evidence": {
      "correctness-off-by-one-pagination": "{\n  \"id\": \"correctness-off-by-one-pagination\",\n  \"input_kind\": \"patch\",\n  \"produced_findings\": [\n    {\n      \"claim\": \"Off-by-one in page slice returns one extra item per page `end = offset + page_size + 1` makes the slice `items[offset : offset + page_size + 1]`, which holds `page_size + 1` elements whenever enough items remain. For `items=[0..9]`, `page_number=1`, `page_size=3`, it returns `[0,1,2,3]` instead of `[0,1,2]`. Page 2 starts at offset 3 and returns `[3,4,5,6]`, so item 3 appears on both pages. The removed line, `items[offset : offset + page_size]`, was correct. Every page returns more items than requested and repeats the first item of the next page. Callers that rely on `page_size` for layout, limits or total-page maths get wrong results. Clients that page through a collection see duplicate records.\",\n      \"extra\": {\n        \"defect_kind\": \"off-by-one\",\n        \"evidence_quotes\": [\n          \"end = offset + page_size + 1\",\n          \"items[offset : offset + page_size + 1]\",\n          \"page_size + 1\",\n          \"items=[0..9]\",\n          \"page_number=1\",\n          \"page_size=3\",\n          \"[0,1,2,3]\",\n          \"[0,1,2]\",\n          \"[3,4,5,6]\",\n          \"items[offset : offset + page_size]\"\n        ]\n      },\n      \"location\": {\n        \"line\": 3,\n        \"path\": \"app/pagination.py\"\n      },\n      \"severity\": \"P0\"\n    }\n  ],\n  \"status\": \"executed\"\n}"
