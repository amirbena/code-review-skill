    "evidence": {
      "correctness-off-by-one-pagination": "{\n  \"id\": \"correctness-off-by-one-pagination\",\n  \"input_kind\": \"patch\",\n  \"produced_findings\": [\n    {\n      \"claim\": \"Off-by-one in page slice returns one extra item per page `end = offset + page_size + 1` makes the slice `items[offset:offset + page_size + 1]`, which has `page_size + 1` elements whenever enough items remain. The previous line was `items[offset : offset + page_size]`. For `items=[1..10]`, `page_number=1`, `page_size=3`, the result is `[1, 2, 3, 4]`. Page 2 starts at offset 3 and returns `[4, 5, 6, 7]`, so item 4 appears on both pages. Every page overshoots its requested size and overlaps the next page by one item. Callers see duplicated records across pages, and any caller that relies on `len(page) <= page_size` is broken. Nothing in the diff suggests this is intentional, such as a look-ahead \\\"has next page\\\" probe.\",\n      \"extra\": {\n        \"defect_kind\": \"off-by-one\",\n        \"evidence_quotes\": [\n          \"end = offset + page_size + 1\",\n          \"items[offset:offset + page_size + 1]\",\n          \"page_size + 1\",\n          \"items[offset : offset + page_size]\",\n          \"items=[1..10]\",\n          \"page_number=1\",\n          \"page_size=3\",\n          \"[1, 2, 3, 4]\",\n          \"[4, 5, 6, 7]\"\n        ]\n      },\n      \"location\": {\n        \"line\": 3,\n        \"path\": \"app/pagination.py\"\n      },\n      \"severity\": \"P0\"\n    }\n  ],\n  \"status\": \"executed\"\n}"
