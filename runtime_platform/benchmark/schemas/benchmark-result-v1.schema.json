{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-review-skill/runtime_platform/benchmark/schemas/benchmark-result-v1.schema.json",
  "title": "Sealed benchmark result record (benchmark-result/v1)",
  "description": "One scheduled benchmark run, sealed once by the execution side before any GitHub write. Canonical prose: runtime_platform/benchmark/benchmark-result-schema.md. Cross-field rules JSON Schema cannot express are enforced by scripts/benchmark_result.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "trigger", "started_at", "finished_at", "sealed_at",
    "lane", "mode", "corpus", "provenance", "runtime", "aggregate", "cases",
    "verification", "baseline", "drift", "execution", "reproduction", "raw",
    "content_sha256"
  ],
  "properties": {
    "schema": { "const": "benchmark-result/v1" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "trigger": { "enum": ["scheduled", "manual", "api"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "sealed_at": { "$ref": "#/$defs/timestamp" },
    "lane": { "enum": ["sentinel", "comprehensive"] },
    "mode": { "enum": ["sentinel", "comprehensive", "full"] },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "case_count", "membership_digest"],
      "properties": {
        "corpus_id": { "$ref": "#/$defs/sha256" },
        "case_count": { "type": "integer", "minimum": 1 },
        "membership_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "repo_sha", "ref", "entrypoint_version", "spec_sha256"],
      "properties": {
        "repo": { "$ref": "#/$defs/text" },
        "repo_sha": { "$ref": "#/$defs/git_sha" },
        "ref": { "$ref": "#/$defs/text" },
        "entrypoint_version": { "$ref": "#/$defs/text" },
        "spec_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_name", "runtime_version", "model_id", "adapter_id"],
      "properties": {
        "runtime_name": { "$ref": "#/$defs/text" },
        "runtime_version": { "$ref": "#/$defs/text" },
        "model_id": { "$ref": "#/$defs/text" },
        "adapter_id": { "$ref": "#/$defs/text" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "severity", "duplicate_noise"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_false_negatives", "total_false_positives",
            "cases_with_false_negatives", "cases_with_false_positives",
            "total_near_misses", "errored_cases"
          ],
          "properties": {
            "total_false_negatives": { "$ref": "#/$defs/count" },
            "total_false_positives": { "$ref": "#/$defs/count" },
            "cases_with_false_negatives": { "$ref": "#/$defs/count" },
            "cases_with_false_positives": { "$ref": "#/$defs/count" },
            "total_near_misses": { "$ref": "#/$defs/count" },
            "errored_cases": { "$ref": "#/$defs/count" }
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_matched", "total_severity_exact", "total_over_severity",
            "total_under_severity", "exact_rate", "cases_with_severity_mismatch"
          ],
          "properties": {
            "total_matched": { "$ref": "#/$defs/count" },
            "total_severity_exact": { "$ref": "#/$defs/count" },
            "total_over_severity": { "$ref": "#/$defs/count" },
            "total_under_severity": { "$ref": "#/$defs/count" },
            "exact_rate": { "$ref": "#/$defs/rate" },
            "cases_with_severity_mismatch": { "$ref": "#/$defs/count" }
          }
        },
        "duplicate_noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_produced", "total_redundant_findings",
            "total_duplicate_clusters", "duplicate_rate", "cases_with_duplication"
          ],
          "properties": {
            "total_produced": { "$ref": "#/$defs/count" },
            "total_redundant_findings": { "$ref": "#/$defs/count" },
            "total_duplicate_clusters": { "$ref": "#/$defs/count" },
            "duplicate_rate": { "$ref": "#/$defs/rate" },
            "cases_with_duplication": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_verified", "runs"],
      "properties": {
        "overall_verified": { "type": "boolean" },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "reason", "case_count", "case_ids"],
            "properties": {
              "passed": { "type": "boolean" },
              "reason": { "$ref": "#/$defs/text" },
              "case_count": { "$ref": "#/$defs/count" },
              "case_ids": { "$ref": "#/$defs/case_ids" }
            }
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "run_id", "record_sha256", "comparable_case_ids", "incomparable_cases"],
      "properties": {
        "state": { "enum": ["bootstrap", "compared", "incomparable"] },
        "run_id": { "anyOf": [{ "$ref": "#/$defs/run_id" }, { "type": "null" }] },
        "record_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "comparable_case_ids": { "$ref": "#/$defs/case_ids" },
        "incomparable_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason", "baseline_fixture_digest", "candidate_fixture_digest"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "reason": { "const": "fixture-digest-mismatch" },
              "baseline_fixture_digest": { "$ref": "#/$defs/sha256" },
              "candidate_fixture_digest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_scope", "observations", "confirmation", "confirmed",
        "unconfirmed", "systemic", "outcome", "attribution", "evidence"
      ],
      "properties": {
        "evaluated_scope": { "$ref": "#/$defs/case_ids" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/drift_record" } },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reruns", "threshold", "max_cases"],
          "properties": {
            "reruns": { "$ref": "#/$defs/count" },
            "threshold": { "type": "integer", "minimum": 1 },
            "max_cases": { "type": "integer", "minimum": 1 }
          }
        },
        "confirmed": { "type": "array", "items": { "$ref": "#/$defs/drift_record" } },
        "unconfirmed": { "type": "array", "items": { "$ref": "#/$defs/unconfirmed_drift_record" } },
        "systemic": { "type": "boolean" },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["none", "drift", "not-evaluated"] },
            "reason": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }
          }
        },
        "attribution": { "enum": ["none", "runtime-changed"] },
        "evidence": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 32768 }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_s", "confirmation_reruns", "session_ref", "warnings"],
      "properties": {
        "duration_s": { "type": "number", "minimum": 0 },
        "confirmation_reruns": { "$ref": "#/$defs/count" },
        "session_ref": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "case_ids", "python_version", "nondeterminism"],
      "properties": {
        "command": { "$ref": "#/$defs/text" },
        "case_ids": { "$ref": "#/$defs/case_ids" },
        "python_version": { "$ref": "#/$defs/text" },
        "nondeterminism": { "$ref": "#/$defs/text" }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_sha256", "location"],
      "properties": {
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "location": { "$ref": "#/$defs/text" }
      }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(sentinel|comprehensive)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
    },
    "rate": {
      "anyOf": [{ "type": "string", "pattern": "^[0-9]+(/[0-9]+)?$" }, { "type": "null" }]
    },
    "case_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "drift_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "drift_type", "expected_finding_key", "detail", "fingerprint"],
      "properties": {
        "case_id": { "$ref": "#/$defs/text" },
        "drift_type": { "$ref": "#/$defs/drift_type" },
        "expected_finding_key": { "$ref": "#/$defs/text" },
        "detail": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "unconfirmed_drift_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "drift_type", "expected_finding_key", "detail", "fingerprint", "reason"],
      "properties": {
        "case_id": { "$ref": "#/$defs/text" },
        "drift_type": { "$ref": "#/$defs/drift_type" },
        "expected_finding_key": { "$ref": "#/$defs/text" },
        "detail": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "reason": { "enum": ["not-reproduced", "unconfirmed-timeout", "systemic-cap"] }
      }
    },
    "drift_type": {
      "enum": ["missed-required-finding", "decision-flip", "severity-accuracy-drop"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "status", "fixture_digest", "metrics", "severity",
        "duplicate_noise", "duration_s"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "status": { "enum": ["executed", "errored"] },
        "fixture_digest": { "$ref": "#/$defs/sha256" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings_completeness", "false_negatives", "false_positives",
            "missed_keys", "incorrect_indices", "near_misses",
            "absorbed_extra_match", "tolerated_unexpected"
          ],
          "properties": {
            "findings_completeness": { "$ref": "#/$defs/text" },
            "false_negatives": { "$ref": "#/$defs/count" },
            "false_positives": { "$ref": "#/$defs/count" },
            "missed_keys": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "incorrect_indices": { "type": "array", "items": { "$ref": "#/$defs/count" } },
            "near_misses": { "$ref": "#/$defs/count" },
            "absorbed_extra_match": { "$ref": "#/$defs/count" },
            "tolerated_unexpected": { "$ref": "#/$defs/count" }
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matched", "severity_exact", "over_severity", "under_severity",
            "exact_rate", "mismatches"
          ],
          "properties": {
            "matched": { "$ref": "#/$defs/count" },
            "severity_exact": { "$ref": "#/$defs/count" },
            "over_severity": { "$ref": "#/$defs/count" },
            "under_severity": { "$ref": "#/$defs/count" },
            "exact_rate": { "$ref": "#/$defs/rate" },
            "mismatches": { "type": "array", "items": { "type": "object" } }
          }
        },
        "duplicate_noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "produced", "clusters", "duplicate_clusters", "redundant_findings",
            "duplicate_rate", "cluster_members"
          ],
          "properties": {
            "produced": { "$ref": "#/$defs/count" },
            "clusters": { "$ref": "#/$defs/count" },
            "duplicate_clusters": { "$ref": "#/$defs/count" },
            "redundant_findings": { "$ref": "#/$defs/count" },
            "duplicate_rate": { "$ref": "#/$defs/rate" },
            "cluster_members": { "type": "array", "items": { "type": "object" } }
          }
        },
        "duration_s": { "type": "number", "minimum": 0 }
      }
    }
  }
}
