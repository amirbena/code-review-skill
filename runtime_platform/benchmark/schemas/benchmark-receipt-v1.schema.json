{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-review-skill/runtime_platform/benchmark/schemas/benchmark-receipt-v1.schema.json",
  "title": "Publisher receipt (benchmark-receipt/v1)",
  "description": "Written once by the publisher after publication; holds only what did not exist at seal time. A summary, never authoritative for idempotency. Canonical prose: runtime_platform/benchmark/benchmark-result-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "record_sha256", "record_commit", "record_permalink",
    "evidence_comment_url", "issue_links", "published_at",
    "publisher_identity", "publisher_run_url", "steps_done"
  ],
  "properties": {
    "schema": { "const": "benchmark-receipt/v1" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "record_sha256": { "$ref": "#/$defs/sha256" },
    "record_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "record_permalink": { "type": "string", "pattern": "^https://" },
    "evidence_comment_url": { "type": "string", "pattern": "^https://" },
    "issue_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "issue", "action"],
        "properties": {
          "fingerprint": { "$ref": "#/$defs/sha256" },
          "issue": { "type": "integer", "minimum": 1 },
          "action": { "enum": ["opened", "commented", "closed", "kept-open"] }
        }
      }
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "publisher_identity": { "type": "string", "minLength": 1 },
    "publisher_run_url": { "type": "string", "pattern": "^https://" },
    "steps_done": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": {
      "type": "string",
      "pattern": "^(sentinel|comprehensive)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
    }
  }
}
